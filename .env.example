# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_API_URL: Google Apps Script Web App exec URL
# Diisi otomatis dari Settings / Secrets di Google AI Studio
VITE_API_URL="https://script.google.com/macros/s/AKfycbzmzg4_0dsCxwAx9JCpstBW46YXaZNfjdRNSlDl9s737aWT05t51vUJe4iYL0oBV_Kdrg/exec"
